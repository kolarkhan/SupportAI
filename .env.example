# ── Database (MongoDB) ──────────────────────────────────────────────────
# Local MongoDB (must be a replica set — see README "MongoDB setup"):
DATABASE_URL="mongodb://localhost:27017/supportai?replicaSet=rs0"
# Or a free MongoDB Atlas cluster (already a replica set, no extra setup):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supportai?retryWrites=true&w=majority"

# ── Auth ──────────────────────────────────────────────────────────────────
# Random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-your-own-generated-secret-see-command-above"

# ── AI Providers ──────────────────────────────────────────────────────────
# Leave blank to run SupportAI fully on the built-in deterministic mock
# provider (no external calls, works offline, great for demos).
# Set either key to switch that capability to a real provider.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Which provider new agents default to: "mock" | "openai" | "anthropic"
DEFAULT_AI_PROVIDER="mock"

# Chat completion + embedding models used when a real provider is active
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
ANTHROPIC_CHAT_MODEL="claude-3-5-sonnet-latest"

# Voyage AI — used for ALL embeddings (document/website ingestion, FAQ
# indexing, chat-time query embedding) regardless of which chat provider an
# agent uses above; this is Anthropic's own recommended embedding provider
# since Claude has no first-party embeddings endpoint. Leave blank to keep
# using the built-in deterministic local embedder (works offline, no cost).
# Get a key at https://dashboard.voyageai.com
VOYAGE_API_KEY=""
VOYAGE_EMBEDDING_MODEL="voyage-3.5"

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Sends team-invite and password-reset emails via a plain SMTP server.
# Leave SMTP_HOST/SMTP_USER/SMTP_PASSWORD blank to log the email content to
# the server console instead (dev-friendly: copy the link from the
# terminal, no inbox needed).
#
# Example below uses Gmail's SMTP relay (free, no domain needed) — but
# SMTP_PASSWORD must be a 16-character "App Password", NOT your normal
# Gmail password (Google blocks plain-password SMTP login). Generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be turned on first). EMAIL_FROM must match SMTP_USER for Gmail — it
# rejects/overrides a From address that isn't the authenticated account (or
# one of its configured aliases). Any other SMTP provider (Outlook, your
# host's mail server, Mailgun/SendGrid's SMTP endpoint, etc.) works the same
# way — just swap the host/port/credentials for theirs.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SupportAI <you@gmail.com>"

# ── App ───────────────────────────────────────────────────────────────────
# Used server-side only (to build links in invite/reset emails) — no
# NEXT_PUBLIC_ prefix needed since nothing reads it in browser code, and
# that prefix would otherwise bundle it into client JS unnecessarily (most
# hosts, including Vercel, flag/warn on that). Set this to your real
# deployed URL in production, e.g. https://your-app.vercel.app
APP_URL="http://localhost:3000"

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB="15"
