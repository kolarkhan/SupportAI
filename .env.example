# ── Database (MongoDB) ──────────────────────────────────────────────────
# Local MongoDB (must be a replica set — see README "MongoDB setup"):
DATABASE_URL="mongodb://localhost:27017/supportai?replicaSet=rs0"
# Or a free MongoDB Atlas cluster (already a replica set, no extra setup):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supportai?retryWrites=true&w=majority"

# ── Auth ──────────────────────────────────────────────────────────────────
# Random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-your-own-generated-secret-see-command-above"

# ── AI Providers ──────────────────────────────────────────────────────────
# Leave blank to run SupportAI fully on the built-in deterministic mock
# provider (no external calls, works offline, great for demos).
# Set either key to switch that capability to a real provider.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Which provider new agents default to: "mock" | "openai" | "anthropic"
DEFAULT_AI_PROVIDER="mock"

# Chat completion + embedding models used when a real provider is active
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
ANTHROPIC_CHAT_MODEL="claude-3-5-sonnet-latest"

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB="15"
